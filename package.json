{
  "name": "taropi",
  "private": true,
  "description": "个人 pi coding agent 插件集合(Monorepo)",
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "taropi-core",
    "taropi-draw",
    "taropi-hud"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "pi": {
    "extensions": [
      "./taropi-core/index.ts",
      "./taropi-draw/index.ts"
    ],
    "prompts": [
      "./taropi-draw/prompts"
    ],
    "skills": [
      "./taropi-plain/skills"
    ]
  },
  "dependencies": {
    "@juicesharp/rpiv-ask-user-question": "2.10.1",
    "@juicesharp/rpiv-i18n": "2.10.1",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.16.11",
    "turndown": "^7.2.4",
    "undici": "^8.10.2",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@types/turndown": "5.0.6",
    "@vitest/coverage-v8": "^5.0.1",
    "typebox": "1.3.34",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
